#!/bin/bash
# Push this run's commit, surviving a base branch that moved during the scan.
#
# A scan runs for tens of minutes and the branch can move under it -- the
# sibling update workflow, dependabot, or a person.  A bare push then throws
# the whole run away.  Our commits only touch the record and the files
# generated from it, so rebasing onto the new tip is conflict-free in
# practice.
#
# The two failures want opposite responses:
#   - a rejected push means we lost a race, so refetch and retry;
#   - a rebase conflict means retrying cannot help, so fail immediately.
set -eu

ATTEMPTS=3

if [ "$(git rev-list --count --right-only "@{upstream}"...HEAD)" -eq 0 ]; then
    echo "No commits to push"
    exit 0
fi

attempt=1
while [ "$attempt" -le "$ATTEMPTS" ]; do
    if ! git pull --rebase; then
        git rebase --abort 2>/dev/null || true
        echo "Rebase onto the updated upstream conflicted;" \
             "leaving this run's commit unpushed" >&2
        exit 1
    fi
    if git push; then
        echo "Pushed on attempt $attempt"
        exit 0
    fi
    echo "Push attempt $attempt lost a race; retrying"
    sleep 5
    attempt=$((attempt + 1))
done

echo "Could not push after $ATTEMPTS attempts" >&2
exit 1
